 "captions": [
  {
   "in": 0.2,
   "out": 4.45,
   "text": "On Mars there's no GPS,\nand help can be 22 minutes away."
  },
  {
   "in": 4.55,
   "out": 6.9,
   "text": "MarsNav keeps a way home on every step."
  },
  {
   "in": 7.1,
   "out": 10.5,
   "text": "It maps every hazard and radio shadow,\nthen plans safe routes."
  },
  {
   "in": 10.7,
   "out": 13.8,
   "text": "It finds the science,\nwith data from seven NASA missions."
  },
  {
   "in": 14.0,
   "out": 16.7,
   "text": "It learns from the suit, and re-plans."
  },
  {
   "in": 16.9,
   "out": 20.2,
   "text": "If a suit leaks,\nevery display turns the crew home."
  },
  {
   "in": 20.4,
   "out": 22.7,
   "text": "Perseverance took 85 sols for this trip."
  },
  {
   "in": 22.7,
   "out": 24.9,
   "text": "MarsNav plans it as an 84-minute walk."
  },
  {
   "in": 25.1,
   "out": 27.4,
   "text": "Forty simulated walks:\nno crew touched their reserve."
  },
  {
   "in": 27.6,
   "out": 29.4,
   "text": "MarsNav. Every step, a way home."
  }
 ],
