// icon and version details shown by Windows Explorer for Build_MarsNav.exe
#include <winver.h>

1 ICON "../../launcher/marsnav.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "MarsNav"
      VALUE "FileDescription", "Build MarsNav.exe (runs build_exe.bat)"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "Build_MarsNav.exe"
      VALUE "LegalCopyright", "MarsNav team, open source (see LICENSE)"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
